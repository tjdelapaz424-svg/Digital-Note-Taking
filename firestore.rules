rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // NOTE: This app uses its own username/password check instead of
    // Firebase Authentication, so Firestore has no reliable way to know
    // "who" is making a request. These rules simply let the app's own
    // pages read and write the collections they need.
    //
    // This is fine for a class project, but it does mean anyone who has
    // your Firebase config values could read/write the database directly
    // (not just through your site). Don't store real sensitive data in it.

    match /users/{userId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/users/$(userId));
      allow update, delete: if true;
    }

    match /classes/{classId} {
      allow read, write: if true;
    }

    match /enrollments/{enrollId} {
      allow read, write: if true;
    }

    match /notebooks/{notebookId} {
      allow read, write: if true;
    }
  }
}
